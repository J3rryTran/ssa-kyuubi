"""Dispatch and observe one occurrence of a pinned Notebook schedule."""

import argparse
import base64
import json
import os
import signal
import sys
import time
import uuid
from typing import Any, Dict
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen


class ApiError(RuntimeError):
    pass


def api_headers() -> Dict[str, str]:
    headers = {"Accept": "application/json", "Content-Type": "application/json"}
    bearer = os.environ.get("KYUUBI_MANAGED_API_BEARER_TOKEN", "").strip()
    cookie = os.environ.get("KYUUBI_MANAGED_API_COOKIE", "").strip()
    user = os.environ.get("KYUUBI_MANAGED_API_USER", "")
    password = os.environ.get("KYUUBI_MANAGED_API_PASSWORD", "")
    if bearer:
        headers["Authorization"] = "Bearer {}".format(bearer)
    elif user:
        encoded = base64.b64encode("{}:{}".format(user, password).encode("utf-8"))
        headers["Authorization"] = "Basic {}".format(encoded.decode("ascii"))
    if cookie:
        headers["Cookie"] = cookie
    return headers


def request_json(url: str, method: str, payload: Dict[str, Any] | None = None) -> Dict[str, Any]:
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    request = Request(url, data=data, headers=api_headers(), method=method)
    try:
        with urlopen(request, timeout=30) as response:
            body = response.read().decode("utf-8")
    except HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(body)
            if isinstance(parsed, dict):
                api_error = parsed.get("error")
                if isinstance(api_error, dict):
                    message = api_error.get("message", parsed.get("message", body))
                elif isinstance(api_error, str):
                    message = api_error
                else:
                    message = parsed.get("message", body)
            else:
                message = body
        except json.JSONDecodeError:
            message = body
        raise ApiError("Kyuubi API returned HTTP {}: {}".format(error.code, message))
    except URLError as error:
        raise ApiError("Could not reach Kyuubi API: {}".format(error.reason))
    try:
        return json.loads(body) if body else {}
    except json.JSONDecodeError as error:
        raise ApiError("Kyuubi API returned invalid JSON") from error


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run the immutable source pinned by one Notebook schedule."
    )
    parser.add_argument(
        "--api-base",
        required=True,
        help="Kyuubi API base, for example http://host:10099/api/v1",
    )
    parser.add_argument("--notebook-id", required=True, help="Notebook with a saved schedule")
    parser.add_argument("--client-request-id", help="Idempotency key for dispatch retries")
    parser.add_argument("--poll-seconds", type=float, default=1.0)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    api_base = args.api_base.rstrip("/")
    notebook_id = quote(args.notebook_id, safe="")
    request_id = args.client_request_id or "managed-notebook-{}".format(uuid.uuid4())
    run = request_json(
        "{}/notebooks/{}/schedule:run".format(api_base, notebook_id),
        "POST",
        {"clientRequestId": request_id},
    )
    run_id = str(run.get("id", "")).strip()
    if not run_id:
        raise ApiError("Notebook dispatch response has no run ID")
    run_url = "{}/notebook-runs/{}".format(api_base, quote(run_id, safe=""))
    interrupted = False

    def cancel(_signum: int, _frame: Any) -> None:
        nonlocal interrupted
        if interrupted:
            return
        interrupted = True
        try:
            request_json(run_url + ":cancel", "POST", {})
        except ApiError as error:
            print("Could not cancel Notebook run: {}".format(error), file=sys.stderr)

    previous_int = signal.signal(signal.SIGINT, cancel)
    previous_term = signal.signal(signal.SIGTERM, cancel)
    last_state = None
    try:
        while True:
            run = request_json(run_url, "GET")
            state = str(run.get("state", "UNKNOWN"))
            if state != last_state:
                print(
                    "run={} state={} revision={} allocation={}".format(
                        run_id,
                        state,
                        run.get("sourceRevisionNumber"),
                        run.get("computeAllocationId"),
                    )
                )
                last_state = state
            if state in {"SUCCEEDED", "FAILED", "CANCELED"}:
                if run.get("errorMessage"):
                    print(str(run["errorMessage"]), file=sys.stderr)
                if state == "SUCCEEDED":
                    return 0
                if state == "CANCELED":
                    return 130
                return 2
            time.sleep(max(0.1, args.poll_seconds))
    finally:
        signal.signal(signal.SIGINT, previous_int)
        signal.signal(signal.SIGTERM, previous_term)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ApiError, ValueError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(70)
